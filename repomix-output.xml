	h := newHandler()
	code := shorten(b, h, "https://example.com/x").Code
	b.ReportAllocs()
	b.ResetTimer()
	b.RunParallel(func(pb *testing.PB) {
		for pb.Next() {
			if rec := get(h, "/"+code); rec.Code != http.StatusFound {
				b.Fatalf("status %d", rec.Code)
			}
		}
